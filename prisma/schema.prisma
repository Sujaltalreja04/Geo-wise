// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComplianceFramework {
  id                    String              @id
  name                  String
  fullName              String
  nameAr                String
  fullNameAr            String
  abbreviation          String
  version               String
  publicationDate       String
  description           String
  descriptionAr         String
  sourceUrl             String
  applicabilityStatus   String              // Pending Confirmation | Applicable | Not Applicable | Partially Applicable | Under Review
  applicabilityRationale String
  responsibleOwner      String
  internalReviewer      String
  assessmentStatus      String              // Not Assessed | Assessment in Progress | Gaps Identified | Ready for Review | Assessed
  reviewDate            String
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  controls              ComplianceControl[]
  assessments           ComplianceAssessment[]
}

model ComplianceControl {
  id                    String              @id
  frameworkId           String
  framework             ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  title                 String
  titleAr               String
  description           String
  requirementText       String
  sourceReference       String
  category              String
  applicabilityStatus   String              // Applicable | Not Applicable | Pending Confirmation
  implementationStatus  String              // Not Assessed | Not Implemented | Partially Implemented | Implemented | Not Applicable | Pending Verification
  controlOwner          String
  reviewer              String
  riskRating            String              // Critical | High | Medium | Low
  assessmentDate        String?
  nextReviewDate        String?
  remediationNotes      String?
  isDraft               Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  assessmentResults     AssessmentResult[]
  findings              ComplianceFinding[]
}

model ComplianceAssessment {
  id                    String              @id
  frameworkId           String
  framework             ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  scope                 String
  period                String
  assessor              String
  reviewer              String
  status                String              // Draft | In Review | Gaps Identified | Approved | Returned for Corrections
  comments              String?
  submittedAt           DateTime?
  approvedAt            DateTime?
  version               Int                 @default(1)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  results               AssessmentResult[]
  findings              ComplianceFinding[]
  evidences             ComplianceEvidence[]
}

model AssessmentResult {
  id                    String               @id @default(cuid())
  assessmentId          String
  assessment            ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  controlId             String
  control               ComplianceControl    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  status                String               // Implemented | Partially Implemented | Not Implemented | Not Applicable | Pending Verification
  observations          String?
  gapsIdentified        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model ComplianceEvidence {
  id                    String                @id
  originalFilename      String
  storageRef            String
  mimeType              String
  fileSize              Int
  checksumSha256        String
  frameworkId           String?
  controlId             String?
  assessmentId          String?
  assessment            ComplianceAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  owner                 String
  uploadedBy            String
  reviewStatus          String                // Pending | Verified | Rejected
  verificationNotes     String?
  expiryDate            String?
  version               Int                   @default(1)
  isArchived            Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model ComplianceFinding {
  id                    String                @id
  frameworkId           String
  controlId             String
  control               ComplianceControl     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  assessmentId          String?
  assessment            ComplianceAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  title                 String
  description           String
  severity              String                // Critical | High | Medium | Low | Informational
  businessImpact        String
  rootCause             String
  recommendedAction     String
  assignedOwner         String
  targetResolutionDate  String
  status                String                // Open | In Progress | Pending Verification | Resolved | Closed | Accepted Risk
  riskAcceptanceJustification String?
  riskAcceptedBy        String?
  riskExpiryDate        String?
  closureApprover       String?
  closureTimestamp      DateTime?
  reviewerComments      String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  remediationActions    RemediationAction[]
}

model RemediationAction {
  id                    String            @id @default(cuid())
  findingId             String
  finding               ComplianceFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actionTitle           String
  description           String
  owner                 String
  dueDate               String
  status                String            // Pending | In Progress | Completed
  completedAt           DateTime?
  evidenceRef           String?
  createdAt             DateTime          @default(now())
}

model DataAsset {
  id                    String            @id
  datasetName           String
  datasetNameAr         String
  description           String
  dataOwner             String
  sourceAuthority       String
  sourceUrl             String?
  classificationType    String            // Official | Reference-Only
  securityClassification String           // public | internal | confidential | restricted
  geographicCoverage    String
  datasetVersion        String
  crs                   String
  importDate            String
  lastUpdatedDate       String
  freshnessThresholdDays Int              @default(90)
  isStale               Boolean           @default(false)
  qualityValidationStatus String          // Validated | Pending Verification | Flagged
  accessRestrictions    String
  associatedAnalyses    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  gaps                  DataGap[]
}

model DataGap {
  id                    String            @id
  dataAssetId           String?
  dataAsset             DataAsset?        @relation(fields: [dataAssetId], references: [id], onDelete: SetNull)
  affectedRequest       String
  gapType               String            // Missing Data | Outdated Layer | Resolution Insufficient | Conflicting Boundary | Unverified Reference
  description           String
  severity              String            // Critical | High | Medium | Low
  owner                 String
  status                String            // Identified | Under Assessment | Remediation Requested | Resolved
  evidenceRef           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model AuditEvent {
  id                    String            @id
  actorId               String
  actorName             String
  action                String
  resourceType          String
  resourceId            String
  outcome               String            // success | denied | error
  details               String
  correlationId         String?
  ipAddress             String?
  tamperProofHash       String
  timestamp             DateTime          @default(now())
}

model ComplianceSettings {
  id                          String      @id @default("default")
  hostingProvider             String      @default("Saudi In-Kingdom Cloud (CST Classified)")
  hostingRegion               String      @default("KSA Region - Riyadh Tier-IV Data Center")
  dataStorageLocation         String      @default("In-Kingdom Sovereign Storage (Tier 2/3 Certified)")
  mfaEnforced                 Boolean     @default(true)
  encryptionAtRest            String      @default("AES-256 (National Cryptographic Standards Compliant)")
  encryptionInTransit         String      @default("TLS 1.3 Strict Suite")
  backupFrequency             String      @default("Automated Hourly Snapshots + Daily Georedundant Offsite")
  lastSuccessfulBackup        String      @default("2026-10-13 03:00:00 UTC")
  lastRecoveryTest            String      @default("2026-09-15 (RTO: 42min, RPO: 12min - Passed)")
  patchStatus                 String      @default("Current - Zero High/Critical CVEs")
  incidentResponseContact     String      @default("cert@aseer.gov.sa / +966-17-224-0000")
  retentionPolicyYears        Int         @default(5)
  independentApprovalRequired Boolean     @default(true)
  updatedAt                   DateTime    @default(now())
  updatedBy                   String      @default("Administrator")
}

model SiteAssessment {
  id                        String                     @id
  siteName                  String
  siteNameAr                String?
  applicantName             String
  authority                 String                     // e.g. Amanat Al-Riyadh / MOMRAH
  assessmentType            String                     // additional_floors | land_use_change | increased_density | setback_variance | general_development
  status                    String                     // completed | processing | requires_study | constrained | data_gap
  overallSpatialVerdict     String                     // Supportive | Supportive with Conditions | Constrained | Requires Further Study | Data Gap
  executiveSummary          String
  executiveSummaryAr        String
  address                   String
  city                      String                     @default("Riyadh")
  district                  String                     @default("Al Olaya")
  latitude                  Float
  longitude                 Float
  areaM2                    Float
  perimeterM                Float
  administrativeArea        String
  crossesAdminBoundary      Boolean                    @default(false)
  proposedDetails           String                     // JSON string of proposed parameters
  boundaryGeoJson           String                     // GeoJSON geometry string
  originalBoundaryGeoJson   String?
  isBoundaryCorrected       Boolean                    @default(false)
  boundaryValidationNotes   String?                    // JSON string
  analysisMethodVersion     String                     @default("v2.4-SpatialEngine")
  dataFreshnessSummary      String?
  version                   Int                        @default(1)
  assessorName              String                     @default("Eng. Tariq Al-Mansoor")
  assessorRole              String                     @default("Senior Planning Officer")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  criteria                  SiteAssessmentCriterion[]
  measurements              SiteAssessmentMeasurement[]
  dataGaps                  SiteAssessmentDataGap[]
  followUps                 SiteAssessmentFollowUp[]
}

model SiteAssessmentCriterion {
  id                    String         @id @default(cuid())
  assessmentId          String
  assessment            SiteAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionKey          String         // boundary_validation | land_use | building_height | development_density | setbacks | road_access | terrain_slope | flood_risk | environmental_heritage | sensitive_facilities | utilities
  title                 String
  titleAr               String
  existingCondition     String
  proposedCondition     String?
  measuredFinding       String
  status                String         // Supportive | Supportive with Conditions | Constrained | Requires Further Study | Data Gap
  evidenceSource        String
  sourceVersionDate     String
  analysisMethod        String
  limitations           String?
  followUpRequired      String?
  sortOrder             Int            @default(0)
  createdAt             DateTime       @default(now())
}

model SiteAssessmentMeasurement {
  id            String         @id @default(cuid())
  assessmentId  String
  assessment    SiteAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  metricName    String
  metricValue   Float
  unit          String
  category      String
  context       String
  createdAt     DateTime       @default(now())
}

model SiteAssessmentDataGap {
  id            String         @id @default(cuid())
  assessmentId  String
  assessment    SiteAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  datasetName   String
  gapType       String         // Missing Data | Outdated Layer | Resolution Insufficient | Conflicting Boundary | Unverified Reference
  description   String
  severity      String         // Critical | High | Medium | Low
  impact        String
  createdAt     DateTime       @default(now())
}

model SiteAssessmentFollowUp {
  id                 String         @id @default(cuid())
  assessmentId       String
  assessment         SiteAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  investigationType  String
  recommendation     String
  priority           String         // High | Medium | Low
  createdAt          DateTime       @default(now())
}